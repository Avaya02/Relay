{
  "name": "relayrun",
  "version": "0.2.2",
  "description": "Run a Relay session against a repository on your own machine — everyone with the link watches the agent work, one person drives.",
  "keywords": [
    "claude",
    "agent",
    "collaboration",
    "pair-programming",
    "cli"
  ],
  "license": "MIT",
  "homepage": "https://relayrun.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Avaya02/Relay.git",
    "directory": "packages/agent"
  },
  "bugs": {
    "url": "https://github.com/Avaya02/Relay/issues"
  },
  "type": "module",
  "bin": {
    "relayrun": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts --mock --server http://localhost:4000 --web http://localhost:3000",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@relay/shared": "workspace:*",
    "@types/node": "26.1.2",
    "@types/ws": "8.18.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
