# Coordination server configuration — the whole of it.
#
# The shortness is the point: this server holds no repository, runs no shell,
# and stores no credentials. Copy to .env for local work; set these as
# environment variables on your host in production.

# Port to bind. Railway, Render and Fly all inject this themselves — do not set
# it there, or you will bind a port the platform isn't routing to.
PORT=4000

# Postgres, for the transcript mirror. Omit entirely and the feature switches
# off cleanly: sessions still work, but a link to a session that is no longer
# live returns "no session" instead of a read-only replay.
# Railway sets this for you when you add a Postgres service.
# DATABASE_URL=postgresql://user:pass@host:5432/relay

# --- Production only -------------------------------------------------------
# Everything below is ignored unless NODE_ENV=production, which your host sets.

# Comma-separated origins allowed to create sessions and open WebSockets.
# REQUIRED in production: leaving it unset means any website can open sockets
# against this server using a visitor's browser. The server logs a warning at
# boot if you forget. No trailing slashes.
# RELAY_ALLOWED_ORIGINS=https://relay.vercel.app,https://relay.yourdomain.com

# How many sessions one IP may create per minute (default 10).
# RELAY_MAX_SESSIONS_PER_MINUTE=10

# Hard ceiling on concurrent in-memory sessions (default 500). Lower this on a
# small instance — each session holds its full event array in memory.
# RELAY_MAX_LIVE_SESSIONS=500

# How long an empty, unhosted session stays resident before being dropped
# (default 600000 = 10 minutes). A session with an agent still attached is
# never reaped regardless of this value.
# RELAY_REAP_MS=600000
