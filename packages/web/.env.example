# Web app configuration.
#
# Both are NEXT_PUBLIC_*, which means Next.js inlines them into the JavaScript
# bundle AT BUILD TIME — they are not read at runtime. Changing either one on
# your host therefore does nothing until you redeploy. This is the single
# easiest thing to get wrong when deploying, so set them before the first build.

# The coordination server's WebSocket URL. Note wss:// (not https://) — an
# https:// value here fails at connect time with a confusing error.
# Defaults to ws://localhost:4000 when unset.
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# This site's own public origin, used to build absolute URLs for link previews
# (og:image must be absolute or it silently doesn't render in Slack/iMessage).
# On Vercel, VERCEL_URL is used automatically if this is unset — but that is
# the deployment hostname, so set this explicitly once you have a real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
