{
  "name": "@relay/video",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "studio": "remotion studio src/index.ts --port 3418",
    "render": "remotion render src/index.ts tour out/tour-master.mp4 --scale 2 --crf 12 && remotion still src/index.ts poster out/poster.png --scale 2",
    "encode": "sh scripts/encode.sh",
    "measure": "remotion still src/index.ts tour out/measure.png --props={\"measure\":true} --frame",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.531",
    "@remotion/google-fonts": "4.0.531",
    "@remotion/tailwind-v4": "4.0.531",
    "lucide-react": "1.28.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.531"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
